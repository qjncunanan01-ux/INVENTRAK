{
  "expo": {
    "name": "Sylver's",
    "slug": "inventrak-mobile",
    "scheme": "inventrak",
    "version": "1.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAF5",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/sylver-symbol.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/sylver-symbol.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sylver's to use your camera to scan product labels.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inventrak.mobile"
    },
    "android": {
      "package": "com.inventrak.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "ff3c277f-c953-418e-b23f-66975a0703d4"
      }
    },
    "owner": "patrickcuevas"
  }
}
