{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://inventrak-demo-api.onrender.com",
        "EXPO_PUBLIC_SYLVER_POLICY_DEMO": "true",
        "EXPO_PUBLIC_DEMO_POLICY_PREVIEW": "true",
        "EAS_RESTORE_CACHE": "0"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://inventrak-api.onrender.com",
        "EXPO_PUBLIC_SYLVER_POLICY_DEMO": "false",
        "EXPO_PUBLIC_DEMO_POLICY_PREVIEW": "false",
        "EAS_RESTORE_CACHE": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
