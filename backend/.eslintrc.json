{
  "env": {
    "es2022": true,
    "node": true,
    "jest": false
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "commonjs"
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "prefer-const": "error",
    "no-var": "error",
    "object-shorthand": "error",
    "prefer-arrow-callback": "error",
    "arrow-spacing": "error",
    "no-trailing-spaces": "error",
    "comma-dangle": ["error", "always-multiline"],
    "key-spacing": "error",
    "space-before-function-paren": ["error", "never"],
    "no-multiple-empty-lines": ["error", { "max": 2, "maxEOF": 1 }],
    "max-len": ["warn", { "code": 120, "ignoreStrings": true, "ignoreTemplateLiterals": true }],
    "complexity": ["warn", 15],
    "max-depth": ["warn", 4],
    "max-params": ["warn", 5]
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "env": {
        "node": true
      },
      "rules": {
        "max-len": "off",
        "no-console": "off"
      }
    }
  ]
}