{
  "openapi": "3.0.3",
  "info": {
    "title": "INVENTRAK Inventory Management API",
    "description": "Backend API for the INVENTRAK inventory management system. Both the SQLite (Express) backend and the npm-free fallback expose this identical contract. Live docs: GET /api/docs",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:4001", "description": "Local backend" }
  ],
  "tags": [
    { "name": "Auth", "description": "Authentication and registration" },
    { "name": "Products", "description": "Product catalog" },
    { "name": "Inventory", "description": "Stock levels per location" },
    { "name": "Stock Movements", "description": "Stock in/out/transfer/adjustment with FIFO lots" },
    { "name": "Locations", "description": "Stockroom locations" },
    { "name": "Order Inquiries", "description": "Customer inquiries and lifecycle" },
    { "name": "Optimization", "description": "EOQ, ROP, safety stock, ABC, turnover" },
    { "name": "Analytics", "description": "Dashboard summaries and exports" },
    { "name": "Alerts", "description": "Low-stock alerts" },
    { "name": "Sales", "description": "Sales transactions" },
    { "name": "Users", "description": "User management (admin)" },
    { "name": "Docs", "description": "API documentation endpoints" }
  ],
  "paths": {
    "/api/docs": {
      "get": {
        "tags": ["Docs"],
        "operationId": "getDocs",
        "summary": "Swagger UI for this API",
        "responses": {
          "200": { "description": "Swagger UI HTML page" }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["Docs"],
        "operationId": "getOpenapi",
        "summary": "This OpenAPI specification document",
        "responses": {
          "200": { "description": "The OpenAPI JSON document" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "operationId": "register",
        "summary": "Register a new customer user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": {
            "description": "Username already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "operationId": "login",
        "summary": "Log in and receive a JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "operationId": "getMe",
        "summary": "Get the authenticated user's profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "operationId": "listProducts",
        "summary": "List products (optionally paginated, searched, filtered)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Page number (enables paginated response)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 }, "description": "Items per page" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search name/category/brand" },
          { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Filter by exact category" }
        ],
        "responses": {
          "200": {
            "description": "List of products (plain array, or { data, pagination } when page/limit provided)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
                    { "$ref": "#/components/schemas/PaginatedProducts" }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "operationId": "createProduct",
        "summary": "Create a product (admin only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreatedId" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/products/categories": {
      "get": {
        "tags": ["Products"],
        "operationId": "listCategories",
        "summary": "List distinct product categories",
        "responses": {
          "200": {
            "description": "Category names",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Products"],
        "operationId": "getProduct",
        "summary": "Get a single product",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Products"],
        "operationId": "updateProduct",
        "summary": "Update a product (admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update acknowledged",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ok" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Products"],
        "operationId": "deleteProduct",
        "summary": "Soft-delete a product (admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Product deactivated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "tags": ["Inventory"],
        "operationId": "getInventory",
        "summary": "Get inventory levels per location",
        "parameters": [
          { "name": "location", "in": "query", "schema": { "type": "string" }, "description": "Filter to one location (name)" },
          { "name": "low_stock", "in": "query", "schema": { "type": "string", "enum": ["true"] }, "description": "Only show items with total < 80" }
        ],
        "responses": {
          "200": {
            "description": "Inventory overview",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryResponse" }
              }
            }
          }
        }
      }
    },
    "/api/locations": {
      "get": {
        "tags": ["Locations"],
        "operationId": "listLocations",
        "summary": "List locations",
        "responses": {
          "200": {
            "description": "Locations",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Location" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Locations"],
        "operationId": "createLocation",
        "summary": "Create a location (admin only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "maxLength": 100 } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Location created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Location" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "Location already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/locations/{id}": {
      "delete": {
        "tags": ["Locations"],
        "operationId": "deleteLocation",
        "summary": "Delete a location (admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Location deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "400": {
            "description": "Cannot delete location with existing stock",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/stock-movement": {
      "post": {
        "tags": ["Stock Movements"],
        "operationId": "createStockMovement",
        "summary": "Record a stock movement (FIFO-aware)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StockMovementInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Movement recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "Product not found or inactive",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/stock-movements": {
      "get": {
        "tags": ["Stock Movements"],
        "operationId": "listStockMovements",
        "summary": "List stock movements",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "type", "in": "query", "schema": { "type": "string" } },
          { "name": "product_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Movements (plain array, or { data, pagination } when page/limit provided)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/StockMovement" } },
                    { "$ref": "#/components/schemas/PaginatedMovements" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/stock-lots": {
      "get": {
        "tags": ["Stock Movements"],
        "operationId": "listStockLots",
        "summary": "List FIFO stock lots",
        "parameters": [
          { "name": "product_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "location_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Stock lots",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/StockLot" } }
              }
            }
          }
        }
      }
    },
    "/api/order-inquiries": {
      "get": {
        "tags": ["Order Inquiries"],
        "operationId": "listOrderInquiries",
        "summary": "List order inquiries",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "approved", "rejected", "fulfilled"] } }
        ],
        "responses": {
          "200": {
            "description": "Inquiries (plain array, or { data, pagination } when page/limit provided)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/OrderInquiry" } },
                    { "$ref": "#/components/schemas/PaginatedInquiries" }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Order Inquiries"],
        "operationId": "createOrderInquiry",
        "summary": "Submit an order inquiry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrderInquiryInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inquiry submitted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/order-inquiries/{id}": {
      "put": {
        "tags": ["Order Inquiries"],
        "operationId": "updateOrderInquiry",
        "summary": "Update inquiry status (pending -> approved -> fulfilled / rejected)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["pending", "approved", "rejected", "fulfilled"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inquiry updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/optimization": {
      "get": {
        "tags": ["Optimization"],
        "operationId": "getOptimizationBulk",
        "summary": "Bulk optimization metrics for all products",
        "responses": {
          "200": {
            "description": "Bulk metrics",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/BulkOptimization" } }
              }
            }
          }
        }
      }
    },
    "/api/optimization/abc": {
      "get": {
        "tags": ["Optimization"],
        "operationId": "getOptimizationAbc",
        "summary": "ABC classification of products",
        "responses": {
          "200": {
            "description": "ABC classifications",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AbcItem" } }
              }
            }
          }
        }
      }
    },
    "/api/optimization/{productId}": {
      "get": {
        "tags": ["Optimization"],
        "operationId": "getOptimization",
        "summary": "EOQ, ROP, safety stock, and turnover for one product",
        "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Optimization metrics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OptimizationMetrics" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/analytics/summary": {
      "get": {
        "tags": ["Analytics"],
        "operationId": "getAnalyticsSummary",
        "summary": "Dashboard summary metrics",
        "responses": {
          "200": {
            "description": "Dashboard summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnalyticsSummary" }
              }
            }
          }
        }
      }
    },
    "/api/analytics/export/{type}": {
      "get": {
        "tags": ["Analytics"],
        "operationId": "exportAnalytics",
        "summary": "Export data as JSON or CSV (admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "type", "in": "path", "required": true, "schema": { "type": "string", "enum": ["products", "inventory", "movements"] } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["json", "csv"] } }
        ],
        "responses": {
          "200": {
            "description": "Exported rows (JSON array, or CSV when format=csv)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "Unknown export type",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": ["Alerts"],
        "operationId": "listAlerts",
        "summary": "List low-stock alerts",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Alerts",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Alert" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/alerts/{id}/resolve": {
      "put": {
        "tags": ["Alerts"],
        "operationId": "resolveAlert",
        "summary": "Resolve an alert (admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Alert resolved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/sales": {
      "get": {
        "tags": ["Sales"],
        "operationId": "listSales",
        "summary": "List sales transactions",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Sales (plain array, or { data, pagination } when page/limit provided)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/Sale" } },
                    { "$ref": "#/components/schemas/PaginatedSales" }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Sales"],
        "operationId": "createSale",
        "summary": "Record a sale",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaleInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sale recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "total"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "total": { "type": "number" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "Product not found or inactive",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "operationId": "listUsers",
        "summary": "List users (admin only)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed or malformed input",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Admin access required",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "details": { "type": "array", "items": { "type": "string" } }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "username", "role", "email"],
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "customer"] },
          "email": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": ["token", "user"],
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "password", "email"],
        "properties": {
          "username": { "type": "string", "maxLength": 50 },
          "password": { "type": "string", "minLength": 6 },
          "email": { "type": "string", "format": "email" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "Product": {
        "type": "object",
        "required": ["id", "name", "category", "price", "status"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "brand": { "type": "string" },
          "description": { "type": "string" },
          "size": { "type": "string" },
          "unit": { "type": "string" },
          "price": { "type": "number" },
          "status": { "type": "string", "enum": ["active", "inactive"] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "ProductInput": {
        "type": "object",
        "required": ["name", "category", "price"],
        "properties": {
          "name": { "type": "string", "maxLength": 200 },
          "category": { "type": "string", "maxLength": 100 },
          "brand": { "type": "string" },
          "description": { "type": "string" },
          "size": { "type": "string" },
          "unit": { "type": "string" },
          "price": { "type": "number", "minimum": 0 },
          "status": { "type": "string", "enum": ["active", "inactive"] }
        }
      },
      "CreatedId": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "integer" } }
      },
      "Ok": {
        "type": "object",
        "required": ["ok"],
        "properties": { "ok": { "type": "boolean" } }
      },
      "Message": {
        "type": "object",
        "required": ["ok", "message"],
        "properties": {
          "ok": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["page", "limit", "total", "totalPages"],
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "PaginatedProducts": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "PaginatedMovements": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/StockMovement" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "PaginatedInquiries": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/OrderInquiry" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "PaginatedSales": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Sale" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "Location": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "InventoryResponse": {
        "type": "object",
        "required": ["locations", "items"],
        "properties": {
          "locations": { "type": "array", "items": { "$ref": "#/components/schemas/Location" } },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["product", "locations", "total"],
              "properties": {
                "product": { "$ref": "#/components/schemas/Product" },
                "locations": { "type": "object", "additionalProperties": { "type": "number" } },
                "total": { "type": "number" }
              }
            }
          }
        }
      },
      "StockMovementInput": {
        "type": "object",
        "required": ["product_id", "qty", "type"],
        "properties": {
          "product_id": { "type": "integer", "minimum": 1 },
          "qty": { "type": "number", "minimum": 0.01 },
          "type": { "type": "string", "enum": ["stock-in", "stock-out", "transfer", "adjustment"] },
          "src_location": { "oneOf": [{ "type": "integer" }, { "type": "string" }], "description": "Location id or name" },
          "dst_location": { "oneOf": [{ "type": "integer" }, { "type": "string" }], "description": "Location id or name" },
          "notes": { "type": "string" },
          "user": { "type": "string" }
        }
      },
      "StockMovement": {
        "type": "object",
        "required": ["id", "product_id", "qty", "type", "created_at"],
        "properties": {
          "id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "qty": { "type": "number" },
          "type": { "type": "string" },
          "src_location": { "type": "integer", "nullable": true },
          "dst_location": { "type": "integer", "nullable": true },
          "notes": { "type": "string" },
          "created_at": { "type": "string" },
          "user": { "type": "string" }
        }
      },
      "StockLot": {
        "type": "object",
        "required": ["id", "product_id", "location_id", "qty", "received_at"],
        "properties": {
          "id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "product_name": { "type": "string" },
          "location_id": { "type": "integer" },
          "location_name": { "type": "string" },
          "qty": { "type": "number" },
          "received_at": { "type": "string" }
        }
      },
      "OrderInquiryInput": {
        "type": "object",
        "required": ["customer_name", "customer_email"],
        "properties": {
          "customer_name": { "type": "string", "maxLength": 100 },
          "customer_email": { "type": "string", "maxLength": 100 },
          "products": { "type": "array", "items": { "type": "string" } },
          "estimated_cost": { "type": "number" },
          "notes": { "type": "string" }
        }
      },
      "OrderInquiry": {
        "type": "object",
        "required": ["id", "customer_name", "customer_email", "status", "created_at"],
        "properties": {
          "id": { "type": "integer" },
          "customer_name": { "type": "string" },
          "customer_email": { "type": "string" },
          "products": { "type": "string" },
          "estimated_cost": { "type": "number" },
          "notes": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected", "fulfilled"] },
          "created_at": { "type": "string" }
        }
      },
      "BulkOptimization": {
        "type": "object",
        "required": ["productId", "productName", "eoq", "annualDemand", "turnoverRatio"],
        "properties": {
          "productId": { "type": "integer" },
          "productName": { "type": "string" },
          "eoq": { "type": "number" },
          "annualDemand": { "type": "number" },
          "turnoverRatio": { "type": "number" }
        }
      },
      "AbcItem": {
        "type": "object",
        "required": ["id", "name", "value", "classification"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "value": { "type": "number" },
          "annualQty": { "type": "number" },
          "classification": { "type": "string", "enum": ["A", "B", "C"] }
        }
      },
      "OptimizationMetrics": {
        "type": "object",
        "required": ["EOQ", "ROP", "safetyStock", "annualDemand", "turnoverRatio", "avgInventory"],
        "properties": {
          "EOQ": { "type": "number" },
          "ROP": { "type": "number" },
          "safetyStock": { "type": "number" },
          "annualDemand": { "type": "number" },
          "turnoverRatio": { "type": "number" },
          "avgInventory": { "type": "number" }
        }
      },
      "AnalyticsSummary": {
        "type": "object",
        "required": [
          "totalProducts", "totalStock", "lowStockItems", "totalLocations",
          "pendingInquiries", "totalSales", "totalMovements", "activeAlerts",
          "topProducts", "monthlyMovements"
        ],
        "properties": {
          "totalProducts": { "type": "integer" },
          "totalStock": { "type": "number" },
          "lowStockItems": { "type": "integer" },
          "totalLocations": { "type": "integer" },
          "pendingInquiries": { "type": "integer" },
          "totalSales": { "type": "number" },
          "totalMovements": { "type": "integer" },
          "activeAlerts": { "type": "integer" },
          "topProducts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "stock_value"],
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "stock_value": { "type": "number" }
              }
            }
          },
          "monthlyMovements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["month", "type", "count"],
              "properties": {
                "month": { "type": "string" },
                "type": { "type": "string" },
                "count": { "type": "integer" }
              }
            }
          }
        }
      },
      "Alert": {
        "type": "object",
        "required": ["id", "product_id", "alert_type", "status"],
        "properties": {
          "id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "location_id": { "type": "integer", "nullable": true },
          "product_name": { "type": "string" },
          "location_name": { "type": "string" },
          "alert_type": { "type": "string" },
          "threshold": { "type": "number" },
          "current_qty": { "type": "number" },
          "status": { "type": "string" },
          "created_at": { "type": "string" },
          "resolved_at": { "type": "string", "nullable": true }
        }
      },
      "SaleInput": {
        "type": "object",
        "required": ["product_id", "qty"],
        "properties": {
          "product_id": { "type": "integer", "minimum": 1 },
          "qty": { "type": "number", "minimum": 0.01 },
          "customer_name": { "type": "string" }
        }
      },
      "Sale": {
        "type": "object",
        "required": ["id", "product_id", "qty", "unit_price", "total_amount", "transaction_date"],
        "properties": {
          "id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "qty": { "type": "number" },
          "unit_price": { "type": "number" },
          "total_amount": { "type": "number" },
          "transaction_date": { "type": "string" },
          "customer_name": { "type": "string" },
          "product_name": { "type": "string" }
        }
      }
    }
  }
}
