{
  "name": "inventrak-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:npmfree": "node src/server_npmfree.js",
    "start:firestore": "node src/server_npmfree.js --firestore",
    "start:firestore:emulator": "node scripts/start-firestore-emulator.js",
    "emulators:start": "firebase emulators:start --only firestore",
    "emulators:export": "firebase emulators:export .firestore-data",
    "seed": "node src/seed.js",
    "seed:firestore": "node src/seed-firestore.js",
    "migrate:firestore": "node src/migrate-firestore.js",
    "migrate:firestore:emulator": "node scripts/migrate-firestore-emulator.js",
    "migrate:check": "node scripts/check-migration-catalog.js",
    "hash:passwords": "node src/hash-passwords.js",
    "notify:test": "node scripts/notify-test.js",
    "sync:firestore": "node src/sync-firestore.js",
    "test": "node --test ./src/test/server.test.js ./src/test/server_npmfree.test.js ./src/test/contract.test.js ./src/test/openapi.test.js ./src/test/firestore-store.test.js ./src/test/password-policy.test.js ./src/test/notify.test.js ./src/test/driver-select.test.js ./src/test/migrate-firestore.test.js ./src/test/password-hash.test.js ./src/test/hash-passwords.test.js ./src/test/sync-firestore.test.js ./src/test/check-migration-catalog.test.js ./src/test/login-lockout.test.js ./src/test/firestore-auth-hash.test.js ./src/test/reset-password.test.js ./src/test/reset-password-expiry.test.js ./src/test/reset-password-lockout.test.js ./src/test/verify-email.test.js ./src/test/verify-email-expiry.test.js",
    "docs:validate": "node scripts/validate-openapi.js",
    "docs:build": "node scripts/build-docs.js",
    "client:generate": "node scripts/generate-client.js",
    "client:check": "node scripts/generate-client.js --check",
    "spec:audit": "node scripts/audit-routes.js",
    "verify": "npm run docs:validate && npm run spec:audit && npm run client:check && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^9.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "swagger-jsdoc": "^6.3.0"
  }
}
