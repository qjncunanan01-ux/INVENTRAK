# INVENTRAK backend — environment variables
# Copy to .env (or paste into your host's dashboard) and fill in the values.
# Nothing here is required to RUN the app; keys enable optional features.

# ---------- Database ----------
# Firestore auto-selection: set BOTH to run on Firebase Firestore.
# FIREBASE_PROJECT_ID=inventrak-6b079
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# (or mount the JSON file and set GOOGLE_APPLICATION_CREDENTIALS=/path/to.json)
# FIREBASE_DATABASE_ID=inventrak        # only if you created a named DB
# DB_DRIVER=json                        # force JSON files even with creds set

# ---------- Auth ----------
# HMAC signing key for tokens (set a fixed random value in production).
# NPMFREE_TOKEN_SECRET=change-me

# ---------- Email: generic SMTP (preferred — delivers to ANY recipient) ----------
# Works with Gmail app passwords, Brevo, Mailgun, etc. If SMTP_HOST is set it
# wins over Resend below. Port convention: 587 -> STARTTLS, 465 -> implicit
# TLS; SMTP_SECURE=true/false overrides.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx      (Gmail app password, NOT your password)
# EMAIL_FROM=INVENTRAK <you@gmail.com>

# ---------- Email (alternative): Resend (https://resend.com) ----------
# Free tier sends ~100 emails/day but the resend.dev sender only reaches the
# account owner's own inbox until a domain is verified.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=INVENTRAK <onboarding@resend.dev>
#   ^ verify your own domain to send as hello@yourdomain.com to anyone

# ---------- SMS: Semaphore (https://semaphore.co — PH gateway) ----------
# Prepaid PH credits; needs a registered sender name in the dashboard.
# SEMAPHORE_API_KEY=xxx
# SEMAPHORE_SENDER_NAME=INVENTRAK

# ---------- SMS (alternative): Twilio ----------
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_FROM=+15005550006

# ---------- Notify smoke test (npm run notify:test) ----------
# TEST_EMAIL=you@example.com
# TEST_PHONE=09171234567
